---
interface Props { level?: 1 | 2 | 3 | 4 | 5 | 6; size?: 'display' | 'xl' | 'lg' | 'md' | 'sm' | 'xs'; id?: string }
const { level = 2, size, id } = Astro.props;
const Tag = `h${level}` as const;
const defaults = { 1: 'display', 2: 'xl', 3: 'lg', 4: 'md', 5: 'sm', 6: 'xs' } as const;
const sizes = {
  display: 'text-4xl sm:text-5xl font-extrabold tracking-tight text-balance',
  xl: 'text-3xl font-bold tracking-tight',
  lg: 'text-2xl font-bold',
  md: 'text-xl font-semibold',
  sm: 'text-lg font-semibold',
  xs: 'text-base font-semibold text-muted',
};
---
<Tag id={id} class:list={['leading-tight text-snow', sizes[size ?? defaults[level]]]}><slot /></Tag>
